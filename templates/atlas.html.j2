<script>
/* ════════════════════════════════════════════════════════════
   数据网格。所有渲染走 DOM API（textContent），不拼 innerHTML，
   避免仓库描述里的字符被当作标记解析。
   ════════════════════════════════════════════════════════════ */
const DATA = {{ data|tojson }};

const META = DATA.meta;
const ITEMS = DATA.items;
const CATS = DATA.facets.cats;
const TAGS = DATA.facets.tags;
const FORMS = DATA.facets.forms;
const LANGS = DATA.facets.languages;
const YEARS = DATA.facets.years;
const CREATED_YEARS = DATA.facets.createdYears || [];

/* 索引：id -> 展示名 */
const CAT_BY = {}, SUB_BY = {}, TAG_BY = {}, FORM_BY = {};
CATS.forEach(c => {
    CAT_BY[c.id] = c;
    c.subs.forEach(s => { SUB_BY[s.id] = { ...s, cat: c.id }; });
});
TAGS.forEach(t => { TAG_BY[t.id] = t; });
FORMS.forEach(f => { FORM_BY[f.id] = f; });

/** 星数分档：由 stars 现算，不依赖数据集里的派生字段 */
function tierOf(stars) { return stars >= 10000 ? 1 : stars >= 1000 ? 2 : 3; }

const TIER_LABEL = {
    zh: { 1: '万人级', 2: '千人级', 3: '起步级' },
    en: { 1: '10k+', 2: '1k+', 3: 'starter' }
};

/* 表格列定义：width 为 0 表示自适应 */
const COLUMNS = [
    { key: 'n',     cls: '',              label: { zh: '仓库', en: 'Repository' } },
    { key: 's',     cls: 'n',             label: { zh: '★', en: '★' } },
    { key: 'l',     cls: 'col-lang',      label: { zh: '语言', en: 'Language' } },
    { key: 'cat',   cls: 'col-domain',    label: { zh: '领域', en: 'Domain' } },
    { key: 'sub',   cls: 'col-sub',       label: { zh: '分类', en: 'Category' } },
    { key: 'p',     cls: 'col-push',      label: { zh: '最近提交', en: 'Last push' } },
];
/* 每列首次点击时的默认方向：数量与日期都从大到新开始，文本按字母升序 */
const DEFAULT_DIR = { s: 'desc', p: 'desc', n: 'asc', l: 'asc', cat: 'asc', sub: 'asc' };

const S = {
    q: '',
    cats: new Set(), subs: new Set(), tags: new Set(),
    forms: new Set(), langs: new Set(), years: new Set(), cyears: new Set(), tiers: new Set(),
    sort: 's', dir: 'desc',
    lang: 'zh', theme: 'light',
    sel: 0,                 // 当前选中行在 CURRENT 中的下标
    shown: 0
};

const TEXT = {
    zh: {
        count: (m, n) => `<b>${m}</b> / ${n} 个项目`,
        repos: '个仓库', updated: '更新',
        search: '搜索仓库、描述、摘要、标签…（空格分隔 = 同时满足）',
        filter: '筛选', light: '浅色', dark: '深色',
        domain: '领域', lang: '语言', tag: 'AI 标签', form: '形态', year: '收藏年份', cyear: '创建年份', star: '星数',
        filterTag: '过滤标签…', showAll: '显示全部', showMore: '显示更多',
        clear: '清除全部筛选', none: '没有命中', noneHint: '减少几个筛选条件，或清空后重新开始。',
        detailEmpty: '从左侧列表选一个项目查看详情',
        desc: '项目描述', summary: 'AI 摘要', aiTags: 'AI 标签', repoTopics: '项目自带标签',
        cat: '领域', sub: '分类', forms: '形态',
        starredAt: '收藏于', created: '创建于', pushedAt: '最近提交', starsN: 'Star', language: '语言',
        github: '在 GitHub 打开', home: '项目主页', noDesc: '该仓库未填写描述',
        close: '关闭', scrimClose: '关闭筛选', back: '← 返回 Stars Archive', backTitle: '回到 Stars Archive 主页',
        dataNav: '订阅与接口', dataTitle: '订阅与数据接口',
        dataLede: '本页的数据可以直接带走：用阅读器订阅更新，或让 Agent 直接调用。',
        dataFeed: 'RSS 订阅', dataApi: '数据接口（供 Agent 调用）',
        dataAll: '全部新收藏',
        apiIndex: '调用入口：分类全貌 + 分片清单',
        apiIndexJsonl: '轻量索引：每行一个精简画像',
        apiCorpus: '全量语料：含完整摘要与 topics',
        apiReadme: '用法说明', apiLlms: '站点自述（llms.txt）',
        dataNote: '订阅源按收藏时间倒序；接口是预先切好的静态文件，无需凭据即可取用。'
    },
    en: {
        count: (m, n) => `<b>${m}</b> of ${n} repositories`,
        repos: 'repos', updated: 'Updated',
        search: 'Search repos, descriptions, summaries, tags… (space = AND)',
        filter: 'Filters', light: 'Light', dark: 'Dark',
        domain: 'Domain', lang: 'Language', tag: 'AI tags', form: 'Form', year: 'Starred year', cyear: 'Created year', star: 'Stars',
        filterTag: 'Filter tags…', showAll: 'Show all', showMore: 'Show more',
        clear: 'Clear all filters', none: 'Nothing matches', noneHint: 'Remove a condition, or clear the filters and start over.',
        detailEmpty: 'Pick a repository to see its details',
        desc: 'Description', summary: 'AI summary', aiTags: 'AI tags', repoTopics: 'Repo topics',
        cat: 'Domain', sub: 'Category', forms: 'Form',
        starredAt: 'Starred', created: 'Created', pushedAt: 'Last push', starsN: 'Stars', language: 'Language',
        github: 'Open on GitHub', home: 'Homepage', noDesc: 'This repository has no description',
        close: 'Close', scrimClose: 'Close filters', back: '← Back to Stars Archive', backTitle: 'Back to the Stars Archive home page',
        dataNav: 'Feeds & API', dataTitle: 'Feeds and data API',
        dataLede: 'This page\u2019s data is portable: subscribe with a feed reader, or let an agent call it directly.',
        dataFeed: 'RSS feeds', dataApi: 'Data API (for agents)',
        dataAll: 'All new stars',
        apiIndex: 'Entry point: taxonomy + shard manifest',
        apiIndexJsonl: 'Light index: one compact profile per line',
        apiCorpus: 'Full corpus: complete summaries and topics',
        apiReadme: 'Usage notes', apiLlms: 'Site self-description (llms.txt)',
        dataNote: 'Feeds are ordered by when you starred each repo. The API is pre-split static files — no credentials needed.'
    }
};
const T = () => TEXT[S.lang];

/* ── 工具 ─────────────────────────────────────────────────── */
const $ = (id) => document.getElementById(id);
const isWide = () => window.matchMedia('(min-width: 1181px)').matches;

function fmt(n) {
    if (n >= 1e6) return (n / 1e6).toFixed(1).replace('.0', '') + 'M';
    if (n >= 1e4) return Math.round(n / 1e3) + 'k';
    if (n >= 1e3) return (n / 1e3).toFixed(1).replace('.0', '') + 'k';
    return String(n);
}
function label(obj) { return obj ? (obj[S.lang] || obj.zh || obj.id) : ''; }

/* 单条记录的可搜索文本，惰性构建一次 */
const HAY = new Map();
function hay(item) {
    if (HAY.has(item.k)) return HAY.get(item.k);
    const text = [item.k, item.d, item.z, item.e, item.l,
        item.t.join(' '),
        item.tags.map(t => TAG_BY[t] ? TAG_BY[t].zh + ' ' + TAG_BY[t].en : t).join(' '),
        CAT_BY[item.cat] ? CAT_BY[item.cat].zh + ' ' + CAT_BY[item.cat].en : '',
        item.sub && SUB_BY[item.sub] ? SUB_BY[item.sub].zh + ' ' + SUB_BY[item.sub].en : '',
        item.forms.map(f => FORM_BY[f] ? FORM_BY[f].zh + ' ' + FORM_BY[f].en : f).join(' '),
    ].join(' ').toLowerCase();
    HAY.set(item.k, text);
    return text;
}

/* ════════════════════════════════════════════════════════════
   筛选
   ════════════════════════════════════════════════════════════ */

/** 单个维度是否命中（skip 用于分面计数时排除自身维度） */
function hit(item, skip) {
    if (skip !== 'cats' && S.cats.size && !item.cats.some(c => S.cats.has(c))) return false;
    if (skip !== 'subs' && S.subs.size && !(item.sub && S.subs.has(item.sub))) return false;
    if (skip !== 'tags' && S.tags.size && !item.tags.some(t => S.tags.has(t))) return false;
    if (skip !== 'forms' && S.forms.size && !item.forms.some(f => S.forms.has(f))) return false;
    if (skip !== 'langs' && S.langs.size && !S.langs.has(item.l)) return false;
    if (skip !== 'years' && S.years.size && !S.years.has(item.y)) return false;
    if (skip !== 'cyears' && S.cyears.size && !S.cyears.has(item.cy)) return false;
    if (skip !== 'tiers' && S.tiers.size && !S.tiers.has(tierOf(item.s))) return false;
    return true;
}

/** 搜索词唯一来源是 S.q；每次派生，避免缓存与输入框不一致 */
function searchTokens() {
    return S.q.trim() ? S.q.trim().toLowerCase().split(/\s+/).filter(Boolean) : [];
}

function match(item) {
    if (!hit(item)) return false;
    const toks = searchTokens();
    if (!toks.length) return true;
    const h = hay(item);
    for (const t of toks) if (h.indexOf(t) === -1) return false;
    return true;
}

function sortValue(item, key) {
    switch (key) {
        case 's': return item.s;
        case 'p': return item.p || '';
        case 'st': return item.st || '';
        case 'n': return item.n.toLowerCase();
        case 'l': return item.l;
        case 'cat': return CAT_BY[item.cat] ? CAT_BY[item.cat].zh : '';
        case 'sub': return item.sub && SUB_BY[item.sub] ? SUB_BY[item.sub].zh : '';
        default: return item.n.toLowerCase();
    }
}

function results() {
    const out = ITEMS.filter(match);
    const dir = S.dir === 'asc' ? 1 : -1;
    const key = S.sort;
    out.sort((a, b) => {
        const x = sortValue(a, key), y = sortValue(b, key);
        const c = (typeof x === 'number' && typeof y === 'number')
            ? x - y
            : String(x).localeCompare(String(y), S.lang === 'zh' ? 'zh' : 'en');
        return (c || a.k.localeCompare(b.k)) * dir;
    });
    return out;
}

/** 分面计数：某维度的计数 = 满足「其它所有条件」的条目数 */
function facetCounts(dim, idOf) {
    const counts = new Map();
    const toks = searchTokens();
    for (const it of ITEMS) {
        if (!hit(it, dim)) continue;
        if (toks.length) {
            const h = hay(it);
            let ok = true;
            for (const t of toks) if (h.indexOf(t) === -1) { ok = false; break; }
            if (!ok) continue;
        }
        const v = idOf(it);
        if (v == null) continue;
        if (Array.isArray(v)) { for (const x of v) counts.set(x, (counts.get(x) || 0) + 1); }
        else counts.set(v, (counts.get(v) || 0) + 1);
    }
    return counts;
}

/* ════════════════════════════════════════════════════════════
   DOM 构建器
   ════════════════════════════════════════════════════════════ */
function el(tag, cls, text) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
}
function chip(name, count, pressed, onToggle, disabled) {
    const b = el('button', 'chip');
    b.type = 'button';
    b.setAttribute('aria-pressed', String(!!pressed));
    b.disabled = !!disabled;
    b.append(el('span', null, name));
    if (count != null) b.append(el('span', 'c num', fmt(count)));
    b.addEventListener('click', onToggle);
    return b;
}
function setToggle(set, v) { if (set.has(v)) set.delete(v); else set.add(v); }

/* ════════════════════════════════════════════════════════════
   左侧栏：领域脊 + 各分面
   ════════════════════════════════════════════════════════════ */
const LANG_FULL = 14;
const TAG_FULL = 20;
let tagFilterText = '';
let langAll = false, tagAll = false;

function renderSpine() {
    const box = $('spine');
    box.textContent = '';
    const counts = facetCounts('cats', it => it.cats);
    CATS.forEach(c => {
        if (!c.count) return;
        const n = counts.get(c.id) || 0;
        const row = el('button', 'spine-row');
        row.type = 'button';
        row.setAttribute('aria-pressed', String(S.cats.has(c.id)));
        if (!n && !S.cats.has(c.id)) row.classList.add('is-empty');
        const dot = el('span', 'dot');
        dot.style.background = c.color || 'var(--fg-3)';
        row.append(dot);
        row.append(el('span', 'spine-name', label(c)));
        row.append(el('span', 'spine-count num', String(n)));
        row.addEventListener('click', () => {
            setToggle(S.cats, c.id);
            if (!S.cats.has(c.id)) dropSubsOf(c.id);
            render();
        });
        box.append(row);

        if (S.cats.has(c.id) && c.subs.length) {
            const subs = el('div', 'subs');
            c.subs.forEach(s => {
                const sc = facetCounts('subs', it => it.sub).get(s.id) || 0;
                const b = el('button', 'sub-row');
                b.type = 'button';
                b.setAttribute('aria-pressed', String(S.subs.has(s.id)));
                b.append(el('span', null, label(s)));
                b.append(el('span', 'num', String(sc)));
                b.addEventListener('click', () => { setToggle(S.subs, s.id); render(); });
                subs.append(b);
            });
            box.append(subs);
        }
    });
}

function dropSubsOf(catId) {
    for (const sid of [...S.subs]) if (SUB_BY[sid] && SUB_BY[sid].cat === catId) S.subs.delete(sid);
}

function renderLangFacet() {
    const box = $('f-lang');
    box.textContent = '';
    const counts = facetCounts('langs', it => it.l);
    const list = langAll ? LANGS : LANGS.slice(0, LANG_FULL);
    list.forEach(l => {
        const n = counts.get(l.name) || 0;
        box.append(chip(l.name, n, S.langs.has(l.name),
            () => { setToggle(S.langs, l.name); render(); }, !n && !S.langs.has(l.name)));
    });
    const more = $('lang-more');
    more.hidden = LANGS.length <= LANG_FULL;
    more.textContent = langAll ? T().showAll + ' ↑' : `${T().showAll} (${LANGS.length})`;
    more.onclick = () => { langAll = !langAll; renderLangFacet(); };
}

function renderTagFacet() {
    const box = $('f-tag');
    box.textContent = '';
    const counts = facetCounts('tags', it => it.tags);
    const q = tagFilterText.trim().toLowerCase();
    let list = TAGS.filter(t => (counts.get(t.id) || 0) > 0 || S.tags.has(t.id));
    if (q) list = TAGS.filter(t => label(t).toLowerCase().includes(q) || t.id.includes(q));
    list.sort((a, b) => (counts.get(b.id) || 0) - (counts.get(a.id) || 0) || b.count - a.count);
    const shown = q ? list : list.slice(0, tagAll ? list.length : TAG_FULL);
    shown.forEach(t => {
        const n = counts.get(t.id) || 0;
        box.append(chip(label(t), n, S.tags.has(t.id),
            () => { setToggle(S.tags, t.id); render(); }, !n && !S.tags.has(t.id)));
    });
    if (!shown.length) box.append(el('div', 'note', '—'));
    const more = $('tag-more');
    more.hidden = !!q || list.length <= TAG_FULL;
    more.textContent = tagAll ? T().showMore + ' ↑' : `${T().showMore} (${list.length})`;
    more.onclick = () => { tagAll = !tagAll; renderTagFacet(); };
}

function renderChipFacet(boxId, source, set, valueOf, dim) {
    const box = $(boxId);
    box.textContent = '';
    const counts = facetCounts(dim, valueOf);
    source.forEach(x => {
        const id = x.id != null ? x.id : x.year;
        const n = counts.get(id) || 0;
        if (!n && !set.has(id)) return;
        // 年份这类分面没有 zh/en 字段，直接用它的值当显示名
        const name = x.id != null ? label(x) : String(x.year);
        box.append(chip(name, n, set.has(id),
            () => { setToggle(set, id); render(); }, !n && !set.has(id)));
    });
}

/* ════════════════════════════════════════════════════════════
   表格
   ════════════════════════════════════════════════════════════ */
const PAGE = 120;
let CURRENT = [];

function renderHead() {
    const tr = $('thead-row');
    tr.textContent = '';
    COLUMNS.forEach(c => {
        const th = el('th', c.cls);
        th.append(document.createTextNode(label(c.label)));
        const ar = el('span', 'ar');
        th.append(document.createTextNode(' '), ar);
        if (S.sort === c.key) {
            th.setAttribute('aria-sort', S.dir === 'asc' ? 'ascending' : 'descending');
            ar.textContent = S.dir === 'asc' ? '▲' : '▼';
        }
        th.addEventListener('click', () => {
            if (S.sort === c.key) S.dir = S.dir === 'asc' ? 'desc' : 'asc';
            else { S.sort = c.key; S.dir = DEFAULT_DIR[c.key] || 'asc'; }
            render();
        });
        tr.append(th);
    });
}

function rowNode(item, idx) {
    const tr = el('tr');
    tr.dataset.i = idx;
    if (idx === S.sel) tr.classList.add('sel');

    const name = el('td', 'name');
    const owner = el('span', null, item.o + '/');
    const repo = el('b', null, item.n);
    name.append(owner, repo);
    tr.append(name);

    tr.append(el('td', 'n star num', '★ ' + fmt(item.s)));
    tr.append(el('td', 'col-lang dim', item.l));

    const dom = el('td', 'col-domain');
    const wrap = el('span', 'dm');
    const dot = el('span', 'dot');
    dot.style.background = (CAT_BY[item.cat] && CAT_BY[item.cat].color) || 'var(--fg-3)';
    wrap.append(dot, document.createTextNode(CAT_BY[item.cat] ? CAT_BY[item.cat].zh : item.cat));
    dom.append(wrap);
    tr.append(dom);

    tr.append(el('td', 'col-sub dim', item.sub && SUB_BY[item.sub] ? SUB_BY[item.sub].zh : '—'));
    tr.append(el('td', 'col-push n dim', item.p || '—'));

    tr.addEventListener('click', () => selectRow(idx, true));
    return tr;
}

function renderRows() {
    const tb = $('tbody');
    tb.textContent = '';
    const frag = document.createDocumentFragment();
    CURRENT.slice(0, S.shown).forEach((it, i) => frag.append(rowNode(it, i)));
    tb.append(frag);

    const empty = $('empty-state');
    const none = !CURRENT.length;
    empty.hidden = !none;
    if (none) {
        $('empty-title').textContent = T().none;
        $('empty-hint').textContent = T().noneHint;
        $('empty-clear').textContent = T().clear;
    }
}

function appendMore() {
    const target = Math.min(S.shown + PAGE, CURRENT.length);
    if (target <= S.shown) return;
    const tb = $('tbody');
    const frag = document.createDocumentFragment();
    for (let i = S.shown; i < target; i++) frag.append(rowNode(CURRENT[i], i));
    tb.append(frag);
    S.shown = target;
}

function selectRow(idx, openDialog) {
    if (idx < 0 || idx >= CURRENT.length) return;
    S.sel = idx;
    [...$('tbody').children].forEach((tr, i) => tr.classList.toggle('sel', i === idx));
    const tr = $('tbody').children[idx];
    if (tr) tr.scrollIntoView({ block: 'nearest' });
    showDetail(CURRENT[idx], openDialog);
}

/* ════════════════════════════════════════════════════════════
   详情面板
   ════════════════════════════════════════════════════════════ */
function buildDetail(item) {
    const box = document.createDocumentFragment();

    box.append(el('h2', null, item.k));
    const sub = [item.o, item.l, CAT_BY[item.cat] ? CAT_BY[item.cat].zh : ''] .filter(Boolean).join(' · ');
    box.append(el('div', 'sub', sub + ' · ' + T().starredAt + ' ' + (item.st || '—')));

    // 统计：全部来自 GitHub 原始字段
    const dl = el('dl', 'dl');
    const stat = (k, v) => { dl.append(el('dt', null, k)); dl.append(el('dd', 'num', v)); };
    stat(T().starsN, '★ ' + fmt(item.s));
    stat(T().language, item.l);
    stat(T().cat, CAT_BY[item.cat] ? CAT_BY[item.cat].zh : '—');
    stat(T().sub, item.sub && SUB_BY[item.sub] ? SUB_BY[item.sub].zh : '—');
    stat(T().starredAt, item.st || '—');
    stat(T().created, item.cr || '—');
    stat(T().pushedAt, item.p || '—');
    box.append(dl);

    const acts = el('div', 'detail-actions');
    const a1 = el('a', 'btn primary', T().github);
    a1.href = item.u; a1.target = '_blank'; a1.rel = 'noopener noreferrer';
    acts.append(a1);
    if (item.h) {
        const a2 = el('a', 'btn', T().home);
        a2.href = item.h; a2.target = '_blank'; a2.rel = 'noopener noreferrer';
        acts.append(a2);
    }
    box.append(acts);

    // 顺序固定：作者原话 -> AI 摘要 -> AI 标签 -> 项目自带标签
    const section = (title, node) => {
        const s = el('div');
        s.append(el('div', 'sec-h', title));
        s.append(node);
        box.append(s);
    };

    const descP = el('div', 'body-text repo-desc',
        item.d || T().noDesc);
    section(T().desc, descP);

    const body = S.lang === 'zh' ? (item.z || item.e) : (item.e || item.z);
    if (body) section(T().summary, el('div', 'body-text', body));

    if (item.tags.length) {
        const c = el('div', 'chips');
        item.tags.forEach(t => { if (TAG_BY[t]) c.append(el('span', 'pill', label(TAG_BY[t]))); });
        section(T().aiTags, c);
    }
    if (item.t.length) {
        const c = el('div', 'chips');
        item.t.forEach(t => c.append(el('span', 'pill', t)));
        section(T().repoTopics, c);
    }
    if (item.forms.length) {
        const c = el('div', 'chips');
        item.forms.forEach(f => { if (FORM_BY[f]) c.append(el('span', 'pill', label(FORM_BY[f]))); });
        section(T().forms, c);
    }
    return box;
}

/**
 * 渲染详情。
 *
 * `openDialog` 必须区分「渲染」与「用户主动打开」：窄屏下若每次 render 都调用
 * showModal()，页面一加载就会弹出一个盖住列表的对话框（曾经如此）。
 * 因此只有用户点击某一行时才允许弹出。
 */
function showDetail(item, openDialog) {
    if (isWide()) {
        const panel = $('detail');
        panel.textContent = '';
        if (!item) { panel.append(el('div', 'detail-empty', T().detailEmpty)); return; }
        panel.append(buildDetail(item));
        return;
    }
    // 窄屏：详情走对话框，且仅在用户主动选择时打开
    const dlg = $('dlg');
    if (!openDialog) return;
    const inner = $('dlg-inner');
    inner.textContent = '';
    if (!item) return;
    inner.append(buildDetail(item));
    if (typeof dlg.showModal === 'function') { if (!dlg.open) dlg.showModal(); }
    else dlg.setAttribute('open', '');
}

/* ════════════════════════════════════════════════════════════
   订阅与数据接口面板
   ════════════════════════════════════════════════════════════ */

/** 一行链接：名称 + 可复制的相对路径 + 附注（订阅源显示条目数） */
function linkRow(name, path, extra) {
    const a = el('a', 'link-row');
    a.href = path;
    a.target = '_blank';
    a.rel = 'noopener';
    a.append(el('span', 'nm', name));
    a.append(el('span', 'pt', path));
    a.append(el('span', 'sz', extra || ''));
    return a;
}

function renderDataPanel() {
    const t = T();
    $('data-title').textContent = t.dataTitle;
    $('data-lede').textContent = t.dataLede;
    $('data-feed-h').textContent = t.dataFeed;
    $('data-api-h').textContent = t.dataApi;
    $('data-note').textContent = t.dataNote;

    // RSS：全站 + 每个有内容的领域（对应的 feed-<id>.xml 由构建脚本生成）
    const feeds = $('data-feeds');
    feeds.textContent = '';
    feeds.append(linkRow(t.dataAll, 'feed.xml', String(META.count)));
    CATS.filter(c => c.count).forEach(c => {
        feeds.append(linkRow(label(c), `feed-${c.id}.xml`, String(c.count)));
    });

    // 接口：按「先看目录、再取分片」的顺序排列
    const apis = $('data-apis');
    apis.textContent = '';
    [
        [t.apiIndex, 'api/index.json'],
        [t.apiIndexJsonl, 'api/index.jsonl'],
        [t.apiCorpus, 'api/repos.jsonl'],
        [t.apiReadme, 'api/README.md'],
        [t.apiLlms, 'llms.txt'],
    ].forEach(([name, path]) => apis.append(linkRow(name, path, '')));
}

function openDataPanel() {
    renderDataPanel();
    const d = $('data-dlg');
    if (typeof d.showModal === 'function') { if (!d.open) d.showModal(); }
    else d.setAttribute('open', '');
    $('data-open').setAttribute('aria-expanded', 'true');
}

/* ════════════════════════════════════════════════════════════
   渲染总入口
   ════════════════════════════════════════════════════════════ */
function render() {
    CURRENT = results();
    if (S.sel >= CURRENT.length) S.sel = 0;
    S.shown = Math.min(PAGE, CURRENT.length);

    renderSpine();
    renderLangFacet();
    renderTagFacet();
    renderChipFacet('f-form', FORMS, S.forms, it => it.forms, 'forms');
    renderChipFacet('f-year', YEARS, S.years, it => it.y, 'years');
    renderChipFacet('f-cyear', CREATED_YEARS, S.cyears, it => it.cy, 'cyears');
    renderTierFacet();
    renderHead();
    renderRows();

    $('count').innerHTML = T().count(CURRENT.length, ITEMS.length);
    $('tb-stat').innerHTML = `<b>${CURRENT.length}</b> ${T().repos} · ` + META.starsCompact + ' ★';

    renderActive();
    updateStatic();
    showDetail(CURRENT[S.sel] || null, false);
    saveHash();
}

function renderTierFacet() {
    const box = $('f-tier');
    box.textContent = '';
    const counts = facetCounts('tiers', it => tierOf(it.s));
    [1, 2, 3].forEach(t => {
        const n = counts.get(t) || 0;
        if (!n && !S.tiers.has(t)) return;
        box.append(chip(TIER_LABEL[S.lang][t], n, S.tiers.has(t),
            () => { setToggle(S.tiers, t); render(); }, !n && !S.tiers.has(t)));
    });
}

function renderActive() {
    const box = $('active');
    box.textContent = '';
    const add = (name, set, v) => box.append(chip(name, null, true, () => { set.delete(v); render(); }));
    S.cats.forEach(v => add(label(CAT_BY[v]), S.cats, v));
    S.subs.forEach(v => add(label(SUB_BY[v]), S.subs, v));
    S.tags.forEach(v => add(label(TAG_BY[v]), S.tags, v));
    S.forms.forEach(v => add(label(FORM_BY[v]), S.forms, v));
    S.langs.forEach(v => add(v, S.langs, v));
    S.years.forEach(v => add(String(v), S.years, v));
    S.cyears.forEach(v => add(String(v), S.cyears, v));
    S.tiers.forEach(v => add(TIER_LABEL[S.lang][v], S.tiers, v));
    if (S.q.trim()) box.append(chip(`“${S.q.trim()}”`, null, true, () => { S.q = ''; $('q').value = ''; render(); }));
    if (box.children.length) {
        const btn = el('button', 'clear', T().clear);
        btn.type = 'button';
        btn.addEventListener('click', clearAll);
        box.append(btn);
    }
}

function clearAll() {
    S.cats.clear(); S.subs.clear(); S.tags.clear();
    S.forms.clear(); S.langs.clear(); S.years.clear(); S.cyears.clear(); S.tiers.clear();
    S.q = ''; $('q').value = '';
    S.sort = 's'; S.dir = 'desc';
    render();
}

function updateStatic() {
    const t = T();
    $('q').placeholder = t.search;
    $('v-count').textContent = META.count + ' ' + t.repos;
    $('g-domain').textContent = t.domain;
    $('g-lang').textContent = t.lang;
    $('g-tag').textContent = t.tag;
    $('g-form').textContent = t.form;
    $('g-year').textContent = t.year;
    $('g-cyear').textContent = t.cyear;
    $('g-star').textContent = t.star;
    $('tag-search').placeholder = t.filterTag;
    $('filter-open-label').textContent = t.filter;
    $('lang-label').textContent = S.lang === 'zh' ? 'EN' : '中文';
    $('theme-label').textContent = S.theme === 'dark' ? t.light : t.dark;
    $('dlg-close').setAttribute('aria-label', t.close);
    $('data-close').setAttribute('aria-label', t.close);
    $('data-open-label').textContent = t.dataNav;
    $('data-open').setAttribute('aria-label', t.dataTitle);
    if ($('data-dlg').open) renderDataPanel();   // 面板开着时切语言要跟着变
    const back = $('back-home');
    if (back) { back.textContent = t.back; back.title = t.backTitle; }
    $('foot-src').textContent = META.count + ' ' + t.repos + ' · ' + t.updated + ' ' + (META.sourceUpdated || '');
    document.documentElement.lang = S.lang === 'zh' ? 'zh-CN' : 'en';
}

/* ════════════════════════════════════════════════════════════
   无限滚动
   ════════════════════════════════════════════════════════════ */
if ('IntersectionObserver' in window) {
    new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting && S.shown < CURRENT.length) appendMore();
    }, { rootMargin: '600px' }).observe($('sentinel'));
}

/* ════════════════════════════════════════════════════════════
   交互绑定
   ════════════════════════════════════════════════════════════ */
let qTimer = null;
$('q').addEventListener('input', (e) => {
    const v = e.target.value;
    clearTimeout(qTimer);
    qTimer = setTimeout(() => { S.q = v; render(); }, 140);
});
$('tag-search').addEventListener('input', (e) => { tagFilterText = e.target.value; renderTagFacet(); });
$('empty-clear').addEventListener('click', clearAll);

document.addEventListener('keydown', (e) => {
    const typing = document.activeElement === $('q') || document.activeElement === $('tag-search');
    if (e.key === '/' && !typing) { e.preventDefault(); $('q').focus(); return; }
    if (typing) {
        if (e.key === 'Escape') { $('q').value = ''; $('q').dispatchEvent(new Event('input')); }
        return;
    }
    if (e.key === 'j' || e.key === 'ArrowDown') { e.preventDefault(); selectRow(Math.min(S.sel + 1, CURRENT.length - 1)); }
    if (e.key === 'k' || e.key === 'ArrowUp') { e.preventDefault(); selectRow(Math.max(S.sel - 1, 0)); }
    if (e.key === 'Enter' && CURRENT[S.sel]) window.open(CURRENT[S.sel].u, '_blank', 'noopener');
});

$('theme').addEventListener('click', () => {
    S.theme = S.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = S.theme;
    localStorage.setItem('atlas.theme', S.theme);
    updateStatic();
});
$('lang').addEventListener('click', () => {
    S.lang = S.lang === 'zh' ? 'en' : 'zh';
    localStorage.setItem('atlas.lang', S.lang);
    render();
});

const rail = $('rail'), scrim = $('scrim');
function openRail(v) {
    rail.classList.toggle('open', v);
    scrim.classList.toggle('on', v);
    $('filter-open').setAttribute('aria-expanded', String(v));
}
$('filter-open').addEventListener('click', () => openRail(!rail.classList.contains('open')));
$('rail-close').addEventListener('click', () => openRail(false));
scrim.addEventListener('click', () => openRail(false));

$('data-open').addEventListener('click', openDataPanel);
$('data-close').addEventListener('click', () => $('data-dlg').close());
$('data-dlg').addEventListener('click', (e) => { if (e.target === $('data-dlg')) $('data-dlg').close(); });
$('data-dlg').addEventListener('close', () => $('data-open').setAttribute('aria-expanded', 'false'));

$('dlg-close').addEventListener('click', () => $('dlg').close());
$('dlg').addEventListener('click', (e) => { if (e.target === $('dlg')) $('dlg').close(); });

let rTimer = null;
window.addEventListener('resize', () => {
    clearTimeout(rTimer);
    rTimer = setTimeout(() => { showDetail(CURRENT[S.sel] || null, false); }, 150);
});

/* ════════════════════════════════════════════════════════════
   URL 状态：筛选可分享
   ════════════════════════════════════════════════════════════ */
function saveHash() {
    const p = new URLSearchParams();
    if (S.q.trim()) p.set('q', S.q.trim());
    const put = (k, s) => { if (s.size) p.set(k, [...s].join(',')); };
    put('cat', S.cats); put('sub', S.subs); put('tag', S.tags);
    put('form', S.forms); put('lang', S.langs); put('year', S.years); put('cyear', S.cyears); put('tier', S.tiers);
    if (S.sort !== 's') p.set('sort', S.sort);
    if (S.dir !== 'desc') p.set('dir', S.dir);
    const h = p.toString();
    history.replaceState(null, '', h ? '#' + h : location.pathname);
}

function loadHash() {
    const p = new URLSearchParams(location.hash.slice(1));
    // 先清空，让「后退 / 手动改 hash」也能正确切回上一次的视图
    S.cats.clear(); S.subs.clear(); S.tags.clear();
    S.forms.clear(); S.langs.clear(); S.years.clear(); S.cyears.clear(); S.tiers.clear();
    S.q = ''; S.sort = 's'; S.dir = 'desc'; S.sel = 0;
    const get = (k, set, cast) => {
        const v = p.get(k);
        if (v) v.split(',').filter(Boolean).forEach(x => set.add(cast ? cast(x) : x));
    };
    if (p.get('q')) S.q = p.get('q');
    get('cat', S.cats); get('sub', S.subs); get('tag', S.tags);
    get('form', S.forms); get('lang', S.langs); get('year', S.years, Number);
    get('cyear', S.cyears, Number); get('tier', S.tiers, Number);
    if (p.get('sort')) S.sort = p.get('sort');
    if (p.get('dir')) S.dir = p.get('dir');
    $('q').value = S.q;
}
window.addEventListener('hashchange', () => { loadHash(); render(); });

/* ════════════════════════════════════════════════════════════
   启动
   ════════════════════════════════════════════════════════════ */
(function boot() {
    S.theme = localStorage.getItem('atlas.theme') || 'light';
    S.lang = localStorage.getItem('atlas.lang') || 'zh';
    document.documentElement.dataset.theme = S.theme;
    loadHash();
    render();
    if (isWide()) {
        // 宽屏先选第一条，右侧面板不留空白（窄屏不预选，避免弹出遮挡列表的对话框）
        selectRow(0, false);
    }
})();
</script>
</body>
</html>
