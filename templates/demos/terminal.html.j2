{#- 风格 3：终端会话 — TUI 风格 / 键盘驱动 -#}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stars Atlas · 终端</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
/* 概念：把整个站做成一个 TUI 程序。
   制表线条、方角、等宽字体、ANSI 式的有限色板；
   交互提示写成命令（/ 搜索、j/k 移动），因为它面向的是开发者。 */
:root{
  --bg:#0B0F14; --bg-2:#0F151C; --line:#1E2A36; --line-2:#2A3A49;
  --fg:#C9D4DE; --fg-dim:#6C7C8C; --fg-hi:#EAF2F8;
  --grn:#5FBF7F; --cyn:#4FB3C9; --yel:#D9B356; --mag:#B87FC9; --red:#D9705F; --blu:#6D9EE8;
  --mono:"JetBrains Mono","SFMono-Regular",Menlo,Consolas,"PingFang SC",monospace;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--mono);font-size:13px;line-height:1.55;
  background-image:radial-gradient(rgba(255,255,255,.014) 1px,transparent 0);background-size:3px 3px}
a{color:var(--blu);text-decoration:none}
a:hover{text-decoration:underline}
.screen{max-width:1000px;margin:0 auto;padding:20px 18px 60px}

/* 顶部状态行，像 tmux 的 status bar */
.statusbar{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;
  background:var(--cyn);color:#04121A;padding:4px 10px;font-weight:700;font-size:12px;letter-spacing:.02em}
.statusbar .dim{opacity:.75;font-weight:500}

.box{border:1px solid var(--line-2);margin-top:18px}
.box > .tb{display:flex;justify-content:space-between;background:var(--bg-2);border-bottom:1px solid var(--line);
  padding:3px 10px;color:var(--fg-dim);font-size:11.5px;letter-spacing:.04em}
.box > .bd{padding:12px 14px}

pre.ascii{margin:0;font-size:11.5px;line-height:1.25;color:var(--cyn);overflow-x:auto}

/* 查询栏 */
.qbar{display:flex;align-items:center;gap:8px;border:1px solid var(--line-2);background:var(--bg-2);padding:8px 12px;margin-top:18px}
.qbar .prompt{color:var(--grn);font-weight:700}
.qbar input{flex:1;background:none;border:0;color:var(--fg-hi);font:inherit;outline:none}
.qbar input::placeholder{color:var(--fg-dim)}
.qbar .hint{color:var(--fg-dim);font-size:11.5px;border:1px solid var(--line);padding:0 5px}

/* 结果行：每条像 ls -l 的一行输出 */
.rows{border:1px solid var(--line-2);margin-top:0}
.row{display:grid;grid-template-columns:2.2rem minmax(0,1fr) 5.5rem 1.6rem 4.6rem 6.2rem;
  gap:10px;align-items:baseline;padding:5px 12px;border-bottom:1px solid var(--line);cursor:pointer}
.row:last-child{border-bottom:0}
.row:hover{background:var(--bg-2)}
.row.sel{background:#12202B;box-shadow:inset 2px 0 0 var(--yel)}
.row .n{color:var(--fg-dim);text-align:right;font-variant-numeric:tabular-nums}
.row .nm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row .nm .ow{color:var(--fg-dim)}
.row .nm .rp{color:var(--fg-hi);font-weight:500}
.row .st{text-align:right;color:var(--yel);font-variant-numeric:tabular-nums}
.row .dm{color:var(--mag);font-size:11.5px;text-align:center}
.row .lg{color:var(--grn);font-size:11.5px}
.row .dt{color:var(--fg-dim);font-size:11.5px;text-align:right;font-variant-numeric:tabular-nums}
.hrow{color:var(--fg-dim);font-size:11px;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid var(--line-2)}
.hrow:hover{background:none}

/* 详情面板：像 less / man 的阅读器 */
.reader{border:1px solid var(--line-2);background:var(--bg-2);padding:0;margin-top:18px}
.reader .hd{border-bottom:1px solid var(--line);padding:8px 12px;display:flex;justify-content:space-between;gap:10px}
.reader .hd .t{color:var(--fg-hi);font-weight:700}
.reader .hd .m{color:var(--fg-dim);font-size:11.5px}
.reader .ct{padding:12px 14px}
.reader dl{display:grid;grid-template-columns:8.5rem 1fr;gap:3px 14px;margin:0 0 12px;font-size:12.5px}
.reader dt{color:var(--fg-dim)}
.reader dd{margin:0;color:var(--fg)}
.reader .sum{color:var(--fg);border-left:2px solid var(--line-2);padding-left:12px;margin:12px 0;white-space:pre-wrap}
/* 项目自带描述：作者原话，与下方 AI 摘要用不同质感区分 */
.reader .repo-desc{color:var(--cyn);border-left:2px solid var(--cyn);padding-left:12px;margin:12px 0;font-size:12.5px}
.cmd{color:var(--grn)}

/* 键位提示 */
.keys{display:flex;gap:16px;flex-wrap:wrap;color:var(--fg-dim);font-size:11.5px;margin-top:14px;border-top:1px solid var(--line);padding-top:10px}
.keys kbd{border:1px solid var(--line-2);padding:0 5px;color:var(--fg);font-family:inherit}
@media(max-width:760px){.row{grid-template-columns:2rem minmax(0,1fr) 4.6rem 4.6rem}.row .lg,.row .dm{display:none}}
</style>
</head>
<body>
<div class="screen">

<div class="statusbar">
  <span>stars-atlas</span>
  <span class="dim">{{ meta.count }} repos · {{ facets.cats | selectattr('count') | list | length }} domains · {{ facets.tags | length }} tags</span>
  <span class="dim">updated {{ updated }}</span>
  <span>NORMAL</span>
</div>

<pre class="ascii">
   ╺╸ STARS ATLAS ╺╸   <span style="color:var(--fg-dim)">index of starred repositories, classified offline</span>

   domain  angle   ·   radius & dot  ★ stars
   ─────────────────────────────────────────────────────────
   ai 454   dv 241   wb 358   da 91    cl 43    sy 110   nw 58
   se 30    md 80    dc 76    of 26    cm 94    mo 88    ds 22
   ed 40    gm 23    ms 6
</pre>

<div class="qbar">
  <span class="prompt">$</span>
  <input id="q" placeholder="grep 仓库名 / 描述 / 主题 …" autocomplete="off">
  <span class="hint">/</span>
</div>

<div class="box">
  <div class="tb"><span>RESULTS — 按 Star 数排序</span><span id="cnt">{{ dense | length }} shown</span></div>
  <div class="bd" style="padding:0">
    <div class="rows" id="rows">
      <div class="row hrow">
        <span class="n">#</span><span class="nm">REPOSITORY</span>
        <span class="st">STARS</span><span class="dm">DOM</span><span class="lg">LANG</span><span class="dt">PUSHED</span>
      </div>
      {% for it in dense %}
      <div class="row" data-i="{{ loop.index0 }}" tabindex="0">
        <span class="n">{{ loop.index }}</span>
        <span class="nm"><span class="ow">{{ it.owner }}/</span><span class="rp">{{ it.repo }}</span></span>
        <span class="st">{{ it.stars_str }}</span>
        <span class="dm">{{ it.domain_code }}</span>
        <span class="lg">{{ it.lang }}</span>
        <span class="dt">{{ it.pushed }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{% set first = dense[0] %}
<div class="reader" id="reader">
  <div class="hd">
    <span class="t">{{ first.name }}</span>
    <span class="m">★ {{ first.stars_str }} · {{ first.lang }} · {{ first.sub_zh }}</span>
  </div>
  <div class="ct">
    <dl>
      <dt>domain</dt><dd>{{ first.domain_zh }} ({{ first.domain }})</dd>
      <dt>subcategory</dt><dd>{{ first.sub_zh }}</dd>
      <dt>ai_tags</dt><dd>{{ first.ai_tags | join(' · ') }}</dd>
      <dt>repo_topics</dt><dd>{{ first.repo_topics[:8] | join(', ') }}</dd>
      <dt>starred</dt><dd>{{ first.starred }} &nbsp; pushed {{ first.pushed }}</dd>
    </dl>
    {% if first.desc %}<div class="repo-desc">{{ first.desc }}</div>{% endif %}
    <div class="sum">{{ first.summary_long }}</div>
    <div><span class="cmd">$</span> open {{ first.url }}</div>
  </div>
</div>

<div class="keys">
  <span><kbd>/</kbd> 搜索</span>
  <span><kbd>j</kbd><kbd>k</kbd> 上下移动</span>
  <span><kbd>↵</kbd> 打开 GitHub</span>
  <span><kbd>Esc</kbd> 清空</span>
</div>

<footer style="color:var(--fg-dim);font-size:11.5px;margin-top:20px;border-top:1px solid var(--line);padding-top:10px">
  Stars Atlas · 分类由规则引擎离线生成 · 数据更新 {{ updated }}
</footer>
</div>

<script>
const DATA = {{ dense | tojson }};
const rows = [...document.querySelectorAll('.row[data-i]')];
const cnt = document.getElementById('cnt');
let sel = 0;

function paint() {
  rows.forEach((r, i) => r.classList.toggle('sel', i === sel));
  const it = DATA[sel];
  const rd = document.getElementById('reader');
  rd.querySelector('.t').textContent = it.name;
  rd.querySelector('.m').textContent = `★ ${it.stars_str} · ${it.lang} · ${it.sub_zh}`;
  const dd = rd.querySelectorAll('dd');
  dd[0].textContent = `${it.domain_zh} (${it.domain})`;
  dd[1].textContent = it.sub_zh;
  dd[2].textContent = it.ai_tags.join(' · ');
  dd[3].textContent = it.repo_topics.slice(0, 8).join(', ');
  dd[4].textContent = `${it.starred}  pushed ${it.pushed}`;
  const rdesc = rd.querySelector('.repo-desc');
  if (rdesc) rdesc.textContent = it.desc || '';
  rd.querySelector('.sum').textContent = it.summary_long;
  rd.querySelector('.cmd').parentElement.lastChild.textContent = ' ' + it.url;
}
function open() { const a = document.createElement('a'); a.href = DATA[sel].url; a.target = '_blank'; a.rel = 'noopener'; a.click(); }

rows.forEach((r, i) => {
  r.addEventListener('click', () => { sel = i; paint(); });
  r.addEventListener('dblclick', open);
});
addEventListener('keydown', e => {
  if (e.key === '/') { e.preventDefault(); document.getElementById('q').focus(); return; }
  if (document.activeElement.tagName === 'INPUT') {
    if (e.key === 'Escape') { document.getElementById('q').value = ''; document.getElementById('q').dispatchEvent(new Event('input')); }
    return;
  }
  if (e.key === 'j') { sel = Math.min(sel + 1, rows.length - 1); paint(); rows[sel].scrollIntoView({block:'nearest'}); }
  if (e.key === 'k') { sel = Math.max(sel - 1, 0); paint(); rows[sel].scrollIntoView({block:'nearest'}); }
  if (e.key === 'Enter') open();
});
document.getElementById('q').addEventListener('input', e => {
  const v = e.target.value.toLowerCase().trim();
  let n = 0;
  rows.forEach((r, i) => {
    const it = DATA[i];
    const hit = !v || (it.name + ' ' + it.desc + ' ' + it.summary + ' ' + it.ai_tags.join(' ') + ' ' + it.repo_topics.join(' ')).toLowerCase().includes(v);
    r.style.display = hit ? '' : 'none';
    if (hit) n++;
  });
  cnt.textContent = `${n} shown`;
});
paint();
</script>
</body>
</html>
