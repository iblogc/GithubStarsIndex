{#- 风格 2：技术评论报刊 — 瑞士式编辑排版 / 一栏主张 + 多栏简讯 -#}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stars Atlas · 技术评论</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Archivo+Black&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet">
<style>
/* 概念：一份关于「最近收藏了什么」的印刷刊物。
   纯白纸、纯黑油墨、单一专色（朱红）。层级靠字号与硬规则线建立，不靠色块。
   头条占据首屏，简讯排成多栏，底部是密集索引 —— 报纸的信息结构。 */
:root{
  --paper:#FFFFFF; --ink:#0E0E0E; --ink-2:#3A3A3A; --ink-3:#787878;
  --rule:#0E0E0E; --hair:#D4D4D4; --spot:#D6261C; --tint:#F4F1EC;
  --sans:"Archivo",-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;
  --black:"Archivo Black","Archivo",sans-serif;
  --serif:"Newsreader","Songti SC",Georgia,serif;
}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.5}
a{color:inherit;text-decoration:none}
.wrap{max-width:1240px;margin:0 auto;padding:0 28px 70px}

/* 报头 */
.masthead{border-bottom:4px solid var(--rule);padding:22px 0 12px;margin-bottom:0}
.masthead .title{font-family:var(--black);font-size:clamp(2.6rem,9vw,6.4rem);line-height:.86;letter-spacing:-.035em;margin:0}
.masthead .title span{color:var(--spot)}
.rail{display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);
  padding:7px 0;margin-top:14px;font-size:.76rem;text-transform:uppercase;letter-spacing:.14em;font-weight:500}
.rail b{font-variant-numeric:tabular-nums}

/* 导语条：像刊物的「本期要点」 */
.standfirst{border-bottom:1px solid var(--rule);padding:16px 0;display:grid;grid-template-columns:auto 1fr;gap:22px;align-items:start}
.standfirst .label{font-family:var(--black);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--spot);
  border:2px solid var(--spot);padding:4px 8px;white-space:nowrap}
.standfirst p{margin:0;font-family:var(--serif);font-size:1.06rem;line-height:1.45;color:var(--ink-2);max-width:64ch}

/* 头条 */
.lead{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:0;border-bottom:3px solid var(--rule)}
.lead-main{padding:26px 30px 26px 0;border-right:1px solid var(--rule)}
.kicker{font-size:.74rem;letter-spacing:.16em;text-transform:uppercase;color:var(--spot);font-weight:600;margin-bottom:10px}
.lead h2{font-family:var(--black);font-size:clamp(1.7rem,3.6vw,2.9rem);line-height:1.02;letter-spacing:-.025em;margin:0 0 14px}
.lead .byline{font-size:.8rem;color:var(--ink-3);margin-bottom:14px;border-bottom:1px solid var(--hair);padding-bottom:10px}
.lead p.body{font-family:var(--serif);font-size:1.08rem;line-height:1.55;color:var(--ink-2);margin:0 0 16px}
.lead-side{padding:26px 0 26px 26px}
.side-item{border-bottom:1px solid var(--hair);padding-bottom:12px;margin-bottom:12px}
.side-item:last-child{border-bottom:0}
.side-item .n{font-family:var(--black);font-size:1.5rem;color:var(--spot);font-variant-numeric:tabular-nums;line-height:1}
.side-item .t{font-weight:600;font-size:.95rem;margin:4px 0 2px}
.side-item .d{font-size:.82rem;color:var(--ink-3);line-height:1.4}

/* 简讯多栏 */
.briefs{border-bottom:1px solid var(--rule);padding:24px 0}
.briefs .head{font-family:var(--black);font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;margin-bottom:16px}
.cols{columns:3;column-gap:34px;column-rule:1px solid var(--hair)}
@media(max-width:900px){.cols{columns:2}}
@media(max-width:620px){.cols{columns:1}}
.brief{break-inside:avoid;margin-bottom:20px}
.brief h3{font-size:.98rem;font-weight:700;line-height:1.25;margin:0 0 5px;letter-spacing:-.005em}
.brief h3 em{font-style:normal;font-weight:400;color:var(--ink-3)}
.brief h3:hover{color:var(--spot)}
.brief .meta{font-size:.72rem;text-transform:uppercase;letter-spacing:.09em;color:var(--ink-3);margin-bottom:6px;display:flex;gap:8px;flex-wrap:wrap}
.brief .meta s{text-decoration:none;color:var(--spot);font-weight:600}
.brief .repo-desc{margin:0 0 4px;font-family:var(--serif);font-style:italic;color:var(--ink-3);font-size:.84rem;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.brief p{margin:0;font-size:.86rem;color:var(--ink-2);line-height:1.45;
  display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}

/* 底部密集索引 */
.index-block{border-top:3px solid var(--rule);margin-top:0;padding-top:14px}
.index-head{font-family:var(--black);font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;margin-bottom:12px;display:flex;justify-content:space-between}
.index-cols{columns:4;column-gap:26px;font-size:.82rem}
@media(max-width:900px){.index-cols{columns:2}}
.idx{break-inside:avoid;margin-bottom:7px;display:flex;gap:6px;align-items:baseline}
.idx b{color:var(--spot);font-weight:700;flex:none;width:1.4rem;text-align:right;font-variant-numeric:tabular-nums}
.idx span{color:var(--ink-2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.idx small{color:var(--ink-3);margin-left:auto;flex:none;font-variant-numeric:tabular-nums}
@media(max-width:820px){.lead{grid-template-columns:1fr}.lead-main{border-right:0;border-bottom:1px solid var(--rule);padding-right:0}.lead-side{padding-left:0}}
</style>
</head>
<body>
<div class="wrap">

<header class="masthead">
  <h1 class="title">STARS<br><span>ATLAS</span></h1>
  <div class="rail">
    <span>第 {{ meta.count }} 号 · 收录 {{ meta.count }} 个项目</span>
    <span>更新 {{ updated.split(' ')[0] }}</span>
    <span>共 {{ meta.starsCompact }} 星标</span>
    <span>{{ facets.cats | selectattr('count') | list | length }} 个领域</span>
  </div>
</header>

<div class="standfirst">
  <span class="label">本期要点</span>
  <p>本刊收录的 {{ meta.count }} 个仓库中，{{ meta.classifiedPct }}% 可归入明确领域；
     AI 以 {{ (facets.cats | selectattr('id','equalto','ai') | list | first).count }} 项居首，
     Web 与服务端 {{ (facets.cats | selectattr('id','equalto','web') | list | first).count }} 项次之。
     以下按领域依次展开。</p>
</div>

{% set lead_item = board[0] %}
{% set side = board[1:5] %}
<section class="lead">
  <div class="lead-main">
    <div class="kicker">本期头条 · {{ lead_item.domain_zh }}</div>
    <h2><a href="{{ lead_item.url }}" target="_blank" rel="noopener">{{ lead_item.repo }}</a></h2>
    <div class="byline">{{ lead_item.owner }} · {{ lead_item.lang }} · ★ {{ lead_item.stars_str }} · 收藏于 {{ lead_item.starred }}</div>
    <p class="body">{{ lead_item.summary_long }}</p>
    <div style="font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;color:var(--ink-3)">
      {{ lead_item.sub_zh }}{% for t in lead_item.ai_tags[:3] %} · {{ t }}{% endfor %}
    </div>
  </div>
  <aside class="lead-side">
    {% for it in side %}
    <div class="side-item">
      <div class="n">{{ it.stars_str }}</div>
      <div class="t"><a href="{{ it.url }}" target="_blank" rel="noopener">{{ it.repo }}</a></div>
      <div class="d">{{ it.owner }} · {{ it.sub_zh }}</div>
    </div>
    {% endfor %}
  </aside>
</section>

<section class="briefs">
  <div class="head">简讯 · 按领域分布</div>
  <div class="cols">
    {% for it in board[5:29] %}
    <article class="brief">
      <h3><a href="{{ it.url }}" target="_blank" rel="noopener">{{ it.repo }} <em>{{ it.owner }}</em></a></h3>
      <div class="meta"><s>{{ it.domain_zh }}</s><span>{{ it.sub_zh }}</span><span>★ {{ it.stars_str }}</span></div>
      {% if it.desc %}<p class="repo-desc">{{ it.desc }}</p>{% endif %}
      <p>{{ it.summary }}</p>
    </article>
    {% endfor %}
  </div>
</section>

<section class="index-block">
  <div class="index-head"><span>全量索引 · 按 Star 数</span><span>{{ board | length }} / {{ meta.count }}</span></div>
  <div class="index-cols">
    {% for it in board %}
    <div class="idx">
      <b>{{ loop.index }}</b>
      <span><a href="{{ it.url }}" target="_blank" rel="noopener">{{ it.repo }}</a></span>
      <small>{{ it.stars_str }}</small>
    </div>
    {% endfor %}
  </div>
</section>

</div>
</body>
</html>
