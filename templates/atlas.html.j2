{#- Stars Atlas —— 数据网格主视图 (Jinja2)

    数据来自 scripts/sync_atlas.py 构建的 dataset：
      data.meta     概览统计
      data.facets   领域/语言/标签/形态/年份 的完整词表与计数
      data.items    每个仓库的分类与展示字段

    版式：三栏主从视图 —— 左侧分面筛选、中间高密度可排序表格、右侧详情面板。
    窄屏下右侧详情收起为对话框，左栏收起为抽屉。

    页面上每个数字都来自 GitHub 原始字段（stars / language / pushed_at / starred_at /
    topics）或规则引擎的分类结果，不含任何自创指标。
-#}
<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Stars Atlas · GitHub 星标索引</title>
<meta name="description" content="把 GitHub Stars 整理成可检索的数据网格：按领域、主题、语言、形态多维筛选与排序。">
<meta name="color-scheme" content="light dark">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Fraunces:opsz,wght@9..144,600&display=swap" rel="stylesheet">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%23eef1f4'/><rect x='6' y='8' width='20' height='3' rx='1' fill='%23172a45'/><rect x='6' y='14' width='14' height='3' rx='1' fill='%232f6feb'/><rect x='6' y='20' width='17' height='3' rx='1' fill='%23172a45'/></svg>">
{#- 订阅与机器接口：让阅读器和 Agent 能自动发现 -#}
<link rel="alternate" type="application/rss+xml" title="Stars Atlas · 全部新收藏" href="feed.xml">
<link rel="alternate" type="application/rss+xml" title="Stars Atlas · 各领域" href="feed-ai.xml">
<link rel="describedby" type="application/json" href="api/index.json">
<link rel="alternate" type="application/json" title="Stars Atlas 数据接口目录" href="api/index.json">
<link rel="llms" type="text/plain" href="llms.txt">

<style>
/* ════════════════════════════════════════════════════════════
   1. 设计令牌
   ════════════════════════════════════════════════════════════ */
:root {
    --bg:        #f4f6f8;
    --panel:     #ffffff;
    --panel-2:   #f9fafb;
    --line:      #e2e6ea;
    --line-2:    #cdd4dc;
    --fg:        #14181f;
    --fg-2:      #4d5561;
    --fg-3:      #858d99;
    --sel:       #2f6feb;
    --sel-bg:    #eaf1fe;
    --star:      #a06d05;
    --ok:        #1a7f4b;
    --shadow:    0 12px 32px -22px rgba(15, 22, 36, .45);

    --radius:    6px;
    --radius-sm: 4px;
    --sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    --serif: 'Fraunces', 'Songti SC', Georgia, serif;
    --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    --ease: cubic-bezier(.22, .61, .36, 1);
    --row-h: 30px;
}
html[data-theme='dark'] {
    --bg:        #0c0f14;
    --panel:     #141920;
    --panel-2:   #10151b;
    --line:      #232a34;
    --line-2:    #333c49;
    --fg:        #e6eaf0;
    --fg-2:      #a4adbb;
    --fg-3:      #6d7787;
    --sel:       #6d9ee8;
    --sel-bg:    #17263d;
    --star:      #d9b356;
    --ok:        #5fbf7f;
    --shadow:    0 16px 40px -26px rgba(0, 0, 0, .9);
}

* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
    margin: 0; background: var(--bg); color: var(--fg);
    font-family: var(--sans); font-size: 13px; line-height: 1.45;
    -webkit-font-smoothing: antialiased; min-height: 100vh;
}
h1, h2, h3, h4 { margin: 0; font-weight: 600; }
p { margin: 0; }
a { color: var(--sel); text-decoration: none; }
a:hover { text-decoration: underline; }
button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
:focus-visible { outline: 2px solid var(--sel); outline-offset: 1px; border-radius: 3px; }
::selection { background: var(--sel-bg); }

.sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}
.skip {
    position: absolute; left: 50%; top: -3rem; transform: translateX(-50%);
    background: var(--sel); color: #fff; padding: .5rem 1rem; z-index: 100;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm); text-decoration: none;
    transition: top .2s var(--ease);
}
.skip:focus { top: 0; }
.num { font-variant-numeric: tabular-nums; }

/* ════════════════════════════════════════════════════════════
   2. 应用骨架：顶栏 + 三栏
   ════════════════════════════════════════════════════════════ */
.app {
    display: grid;
    grid-template-columns: 204px minmax(0, 1fr) 352px;
    grid-template-rows: auto minmax(0, 1fr);
    height: 100vh;
    max-width: 100vw;
    overflow: hidden;
}

/* 顶栏 */
.topbar {
    grid-column: 1 / -1;
    display: flex; align-items: center; gap: 14px;
    height: 50px; padding: 0 16px;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
    z-index: 20;
}
.brand { display: flex; align-items: baseline; gap: 7px; white-space: nowrap; }
.brand b { font-family: var(--serif); font-size: 1.05rem; font-weight: 600; letter-spacing: -.01em; }
.brand span { color: var(--fg-3); font-size: .78rem; }
.search {
    flex: 1; max-width: 440px;
    display: flex; align-items: center; gap: 7px;
    border: 1px solid var(--line-2); border-radius: var(--radius);
    padding: 5px 10px; background: var(--panel);
    transition: border-color .15s var(--ease), box-shadow .15s var(--ease);
}
.search:focus-within { border-color: var(--sel); box-shadow: 0 0 0 2px var(--sel-bg); }
.search input { flex: 1; min-width: 0; border: 0; outline: none; font: inherit; background: none; color: var(--fg); }
.search input::placeholder { color: var(--fg-3); }
.search kbd { font-family: var(--sans); font-size: .7rem; color: var(--fg-3); border: 1px solid var(--line); border-radius: 3px; padding: 0 .3rem; }
.tb-right { margin-left: auto; display: flex; align-items: center; gap: 8px; }
.tb-stat { color: var(--fg-3); font-variant-numeric: tabular-nums; white-space: nowrap; font-size: 12.5px; }
.tb-stat b { color: var(--fg); font-weight: 600; }
.toggle {
    display: inline-flex; align-items: center; gap: 5px;
    border: 1px solid var(--line-2); border-radius: var(--radius);
    padding: 4px 9px; color: var(--fg-2); font-size: 12.5px;
    white-space: nowrap;   /* 顶栏按钮的文字不折行，挤不下时整颗换行 */
    transition: color .15s var(--ease), border-color .15s var(--ease);
}
.toggle:hover { color: var(--fg); border-color: var(--fg-3); }
.filter-open { display: none; }

/* 左：分面筛选 */
.rail {
    background: var(--panel);
    border-right: 1px solid var(--line);
    overflow-y: auto;
    padding: 10px 0 40px;
    scrollbar-width: thin;
}
.rail::-webkit-scrollbar { width: 7px; }
.rail::-webkit-scrollbar-thumb { background: var(--line-2); border-radius: 4px; }
.rail-close { display: none; }
.group { padding: 0 12px 15px; }
.group > h2 {
    margin: 0 0 7px; font-size: 10.5px; letter-spacing: .07em; text-transform: uppercase;
    color: var(--fg-3); font-weight: 600;
}
.spine { display: flex; flex-direction: column; }
.spine-row {
    display: grid; grid-template-columns: 6px minmax(0, 1fr) auto;
    align-items: center; gap: 7px;
    width: 100%; padding: 3px 7px; border-radius: var(--radius-sm);
    text-align: left; color: var(--fg-2);
    transition: background .13s var(--ease), color .13s var(--ease);
}
.spine-row:hover { background: var(--panel-2); color: var(--fg); }
html[data-theme='dark'] .spine-row:hover { background: #1a212b; }
.spine-row[aria-pressed='true'] { background: var(--sel-bg); color: var(--sel); font-weight: 500; }
.dot { width: 7px; height: 7px; border-radius: 2px; display: block; }
.spine-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.spine-count { color: var(--fg-3); font-variant-numeric: tabular-nums; font-size: 11.5px; }
.spine-row[aria-pressed='true'] .spine-count { color: var(--sel); }
.spine-row.is-empty { opacity: .42; }

.subs { margin: 1px 0 5px 20px; display: flex; flex-direction: column; }
.sub-row {
    display: flex; justify-content: space-between; gap: 8px;
    padding: 2px 7px; border-radius: var(--radius-sm);
    font-size: 12px; color: var(--fg-3); text-align: left;
}
.sub-row:hover { color: var(--fg); background: var(--panel-2); }
html[data-theme='dark'] .sub-row:hover { background: #1a212b; }
.sub-row[aria-pressed='true'] { color: var(--sel); background: var(--sel-bg); font-weight: 500; }

.chips { display: flex; flex-wrap: wrap; gap: 4px; }
.chip {
    display: inline-flex; align-items: center; gap: 4px;
    border: 1px solid var(--line-2); border-radius: 999px;
    padding: 1px 8px; font-size: 11.5px; color: var(--fg-2);
    max-width: 100%;
    transition: border-color .13s var(--ease), color .13s var(--ease), background .13s var(--ease);
}
.chip:hover { border-color: var(--fg-3); color: var(--fg); }
.chip[aria-pressed='true'] { background: var(--sel-bg); border-color: var(--sel); color: var(--sel); }
.chip .c { color: var(--fg-3); font-size: 10.5px; font-variant-numeric: tabular-nums; }
.chip[aria-pressed='true'] .c { color: inherit; }
.chip:disabled { opacity: .35; cursor: not-allowed; }
.chip span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.facet-more { font-size: 11.5px; color: var(--sel); padding: 3px 2px 0; }
.facet-search {
    width: 100%; margin-bottom: 6px;
    background: var(--panel-2); border: 1px solid var(--line);
    border-radius: var(--radius-sm); padding: 4px 7px; color: var(--fg); font-size: 12px;
}
html[data-theme='dark'] .facet-search { background: #10151b; }
.note { color: var(--fg-3); font-size: 12px; padding: 2px 0; }

/* 中：表格 */
.main { display: flex; flex-direction: column; min-width: 0; background: var(--panel); }
.bar {
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    padding: 7px 12px; border-bottom: 1px solid var(--line);
    background: var(--panel); position: sticky; top: 0; z-index: 6;
}
.bar-count { color: var(--fg-3); font-size: 12.5px; }
.bar-count b { color: var(--fg); font-weight: 600; }
.active { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; }
.active:empty { display: none; }
.clear { font-size: 12px; color: var(--fg-3); text-decoration: underline; text-underline-offset: 2px; }
.clear:hover { color: var(--fg); }

.tablewrap { flex: 1; overflow: auto; min-width: 0; }
table { border-collapse: separate; border-spacing: 0; width: 100%; font-size: 12.5px; }
thead th {
    position: sticky; top: 0; z-index: 5;
    background: var(--panel-2); border-bottom: 1px solid var(--line-2);
    text-align: left; padding: 6px 10px; font-weight: 600; color: var(--fg-2);
    white-space: nowrap; cursor: pointer; user-select: none;
}
html[data-theme='dark'] thead th { background: #171d25; }
thead th:hover { color: var(--fg); }
thead th[aria-sort] { color: var(--sel); }
thead th .ar { font-size: 9.5px; }
tbody tr { border-bottom: 1px solid var(--line); cursor: pointer; }
tbody tr:hover { background: var(--panel-2); }
html[data-theme='dark'] tbody tr:hover { background: #1a212b; }
tbody tr.sel { background: var(--sel-bg); box-shadow: inset 2px 0 0 var(--sel); }
td { padding: 4px 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 22rem; }
td.name b { font-weight: 600; }
td.name span { color: var(--fg-3); }
td.n { text-align: right; font-variant-numeric: tabular-nums; }
td.star { color: var(--star); font-weight: 600; }
td.dim { color: var(--fg-3); }
td .dm { display: inline-flex; align-items: center; gap: 5px; }
.empty {
    padding: 3.5rem 1rem; text-align: center; color: var(--fg-2);
}
.empty h3 { font-family: var(--serif); font-size: 1.1rem; margin-bottom: .4rem; }
.empty p { color: var(--fg-3); font-size: 12.5px; margin-bottom: 1rem; }
.btn {
    display: inline-block; border: 1px solid var(--line-2); border-radius: var(--radius-sm);
    padding: 5px 11px; font-size: 12.5px; color: var(--fg);
}
.btn:hover { border-color: var(--sel); color: var(--sel); text-decoration: none; }
.btn.primary { background: var(--sel); color: #fff; border-color: var(--sel); font-weight: 500; }
.btn.primary:hover { filter: brightness(1.08); color: #fff; }
#sentinel { height: 1px; }

/* 右：详情面板 */
.detail {
    background: var(--panel); border-left: 1px solid var(--line);
    overflow-y: auto; padding: 14px 16px 40px;
    scrollbar-width: thin;
}
.detail::-webkit-scrollbar { width: 7px; }
.detail::-webkit-scrollbar-thumb { background: var(--line-2); border-radius: 4px; }
.detail h2 { font-family: var(--serif); font-size: 1.12rem; letter-spacing: -.01em; word-break: break-word; overflow-wrap: anywhere; }
.detail .sub { color: var(--fg-3); font-size: 12px; margin: 2px 0 13px; }
.dl { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 12px; font-size: 12.5px; margin: 0 0 14px; }
.dl dt { color: var(--fg-3); }
.dl dd { margin: 0; overflow-wrap: anywhere; }
.sec-h {
    font-size: 10.5px; letter-spacing: .07em; text-transform: uppercase; color: var(--fg-3);
    font-weight: 600; margin: 16px 0 6px; padding-bottom: 4px; border-bottom: 1px solid var(--line);
}
.body-text { color: var(--fg-2); line-height: 1.6; font-size: 12.5px; }
/* 作者原话用左侧竖线与 AI 摘要区分开 */
.repo-desc { border-left: 2px solid var(--line-2); padding-left: 9px; color: var(--fg); }
.pill {
    display: inline-block; font-size: 11px; padding: 1px 7px; border-radius: 3px;
    border: 1px solid var(--line); color: var(--fg-2); background: var(--panel-2);
}
html[data-theme='dark'] .pill { background: #171d25; }
.detail-actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
.detail-empty { color: var(--fg-3); font-size: 12.5px; padding: 2rem 0; text-align: center; }

/* 页脚链接 */
.foot {
    grid-column: 1 / -1;
    display: none;
    align-items: center; gap: 14px; flex-wrap: wrap;
    padding: 7px 16px; border-top: 1px solid var(--line);
    background: var(--panel); color: var(--fg-3); font-size: 11.5px;
}
.foot a { color: var(--fg-2); }

/* 对话框（窄屏详情） */
.dlg {
    width: min(46rem, 94vw); max-height: 86vh; margin: auto; padding: 0;
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--panel); color: var(--fg); box-shadow: var(--shadow); overflow: hidden;
}
.dlg::backdrop { background: rgba(8, 12, 18, .6); }
.dlg-inner { max-height: 86vh; overflow-y: auto; padding: 22px 24px 20px; }
.dlg-lede { color: var(--fg-2); font-size: 12.5px; line-height: 1.6; margin: 4px 0 0; }
.dlg-note {
    margin-top: 18px; padding-top: 12px; border-top: 1px solid var(--line);
    color: var(--fg-3); font-size: 11.5px; line-height: 1.6;
}
.icon-toggle { gap: 6px; }
/* 链接网格：每项一行，名称 + 路径 + 字节数，便于直接读或复制 */
.link-grid { display: flex; flex-direction: column; gap: 2px; }
.link-grid.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 14px; }
@media (max-width: 620px) { .link-grid.two-col { grid-template-columns: 1fr; } }
/* 两栏下每格更窄：名称列自适应，路径与条目数靠右 */
.link-grid.two-col .link-row { grid-template-columns: minmax(0, 1fr) auto auto; gap: 10px; }
.link-row {
    display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) auto;
    align-items: baseline; gap: 10px;
    padding: 5px 7px; border-radius: var(--radius-sm);
    text-decoration: none; color: var(--fg);
    transition: background .13s var(--ease);
}
html[data-theme='dark'] .link-row:hover { background: #1a212b; }
.link-row:hover { background: var(--panel-2); text-decoration: none; }
.link-row .nm { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.link-row .pt { color: var(--fg-3); font-family: var(--mono); font-size: 11px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.link-row .sz { color: var(--fg-3); font-size: 11px; font-variant-numeric: tabular-nums; white-space: nowrap; }
.link-row:hover .nm { color: var(--sel); }
.dlg .close {
    position: absolute; top: .7rem; right: .8rem;
    width: 1.9rem; height: 1.9rem; display: grid; place-items: center;
    border: 1px solid transparent; border-radius: 50%; color: var(--fg-3);
}
.dlg .close:hover { color: var(--fg); border-color: var(--line); }

.scrim {
    position: fixed; inset: 0; z-index: 55; background: rgba(8, 12, 18, .5);
    opacity: 0; visibility: hidden; transition: opacity .2s var(--ease);
}
.scrim.on { opacity: 1; visibility: visible; }

/* ════════════════════════════════════════════════════════════
   3. 响应式
   ════════════════════════════════════════════════════════════ */
@media (max-width: 1180px) {
    .app { grid-template-columns: 204px minmax(0, 1fr); }
    .detail { display: none; }          /* 详情改用对话框 */
}
@media (max-width: 860px) {
    .app { grid-template-columns: minmax(0, 1fr); height: auto; overflow: visible; }
    .topbar { flex-wrap: wrap; height: auto; padding: 8px 12px; gap: 8px; }
    .search { flex: 1 1 100%; max-width: none; order: 3; }
    /* 按钮文字不折行（见 .toggle），所以这里要允许整颗按钮换行，
       否则窄屏下 .tb-right 会把文档撑宽 */
    .tb-right { margin-left: 0; flex-wrap: wrap; }
    .tb-stat { font-size: 12px; }
    .filter-open { display: inline-flex; }
    .rail {
        position: fixed; inset: 0 auto 0 0; z-index: 60;
        width: min(20rem, 86vw); padding: 12px 0 40px;
        transform: translateX(-102%); transition: transform .25s var(--ease);
        box-shadow: var(--shadow);
    }
    .rail.open { transform: none; }
    .rail-close { display: inline-flex; margin: 0 12px 10px; }
    .main { height: auto; }
    .tablewrap { max-height: 70vh; }
    .foot { display: flex; }
    /* 窄屏隐藏次要列，保留可读的核心信息 */
    th.col-lang, td.col-lang, th.col-sub, td.col-sub { display: none; }
}
@media (max-width: 620px) {
    th.col-domain, td.col-domain, th.col-push, td.col-push { display: none; }
    .tb-stat { display: none; }   /* 极窄屏优先保证操作按钮完整可见 */
}
@media (prefers-reduced-motion: reduce) {
    * { transition-duration: .01ms !important; animation-duration: .01ms !important; }
}
</style>
</head>
<body>
<a class="skip" href="#rows-heading">跳到结果列表</a>

<div class="app">

    <div class="topbar">
        <div class="brand">
            <b>Stars Atlas</b>
            <span id="v-count"></span>
        </div>

        <label class="search" for="q">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="7" cy="7" r="4.6" stroke="currentColor" stroke-width="1.4"/>
                <path d="M10.6 10.6 14 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
            <input id="q" type="search" autocomplete="off" spellcheck="false">
            <kbd>/</kbd>
        </label>

        <div class="tb-right">
            <span class="tb-stat" id="tb-stat" aria-live="polite"></span>
            <button class="toggle filter-open" id="filter-open" aria-controls="rail" aria-expanded="false">
                <span id="filter-open-label">筛选</span>
            </button>
            <button class="toggle" id="theme" aria-label="切换配色">
                <span id="theme-label"></span>
            </button>
            <button class="toggle" id="lang" aria-label="切换语言">
                <span id="lang-label">EN</span>
            </button>
            <button class="toggle icon-toggle" id="data-open" aria-haspopup="dialog"
                    aria-controls="data-dlg" aria-expanded="false">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <circle cx="4" cy="8" r="1.6" fill="currentColor"/>
                    <path d="M6.2 8h5.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                    <circle cx="13" cy="4.4" r="1.5" stroke="currentColor" stroke-width="1.3"/>
                    <circle cx="13" cy="11.6" r="1.5" stroke="currentColor" stroke-width="1.3"/>
