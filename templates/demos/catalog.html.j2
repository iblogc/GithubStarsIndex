{#- 风格 1：索引卡片目录 — 纸质档案柜 / 图书馆卡片目录 -#}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stars Atlas · 索引卡片目录</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Sans+Condensed:wght@500;600&display=swap" rel="stylesheet">
<style>
/* 概念：一张张打字机时代的索引卡，按领域用彩色标签页分隔。
   纸面米白、细描边、零阴影 —— 质感来自纸与规则线，而不是发光。 */
:root{
  --paper:#F6F2E8; --paper-2:#EFEADC; --ink:#232019; --ink-2:#5C5647; --ink-3:#8C8574;
  --rule:#D8D1BE; --rule-2:#C6BDA5; --accent:#8C2F1F;
  --sans:"IBM Plex Sans","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  --cond:"IBM Plex Sans Condensed","IBM Plex Sans","PingFang SC",sans-serif;
}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:14.5px;line-height:1.6;
  background-image:linear-gradient(var(--rule) 1px,transparent 1px);background-size:100% 30px;}
a{color:inherit;text-decoration:none}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px 80px}

/* 报头：像档案柜顶部的标签 */
header.top{border-bottom:3px double var(--rule-2);padding:34px 0 18px;margin-bottom:26px}
.top-row{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap}
h1{font-family:var(--cond);font-size:clamp(2rem,5.5vw,3.4rem);font-weight:600;letter-spacing:-.01em;margin:0;line-height:1}
h1 small{display:block;font-size:.85rem;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-3);margin-top:8px}
.filing{display:flex;gap:28px;font-family:var(--cond);font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3)}
.filing b{display:block;font-family:var(--sans);font-size:1.5rem;letter-spacing:0;text-transform:none;color:var(--ink);font-variant-numeric:tabular-nums}

/* 领域索引标签（像卡片盒里的分隔片） */
.tabs{display:flex;flex-wrap:wrap;gap:0;border-bottom:1px solid var(--rule-2);margin-bottom:30px}
.tab{font-family:var(--cond);font-size:.82rem;letter-spacing:.05em;text-transform:uppercase;
  padding:9px 14px 8px;border:1px solid var(--rule-2);border-bottom:none;margin-right:-1px;
  background:var(--paper-2);color:var(--ink-2);position:relative;top:1px}
.tab:hover{background:var(--paper)}
.tab.on{background:var(--paper);color:var(--ink);font-weight:600;border-bottom:1px solid var(--paper)}
.tab i{font-style:normal;color:var(--ink-3);margin-left:6px;font-variant-numeric:tabular-nums}

/* 卡片网格 */
.section-head{display:flex;align-items:baseline;gap:12px;margin:34px 0 16px;border-bottom:1px solid var(--rule-2);padding-bottom:8px}
.section-head h2{font-family:var(--cond);font-size:1.05rem;letter-spacing:.08em;text-transform:uppercase;margin:0;font-weight:600}
.section-head span{font-size:.8rem;color:var(--ink-3)}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(340px,100%),1fr));gap:18px}
.card{background:var(--paper);border:1px solid var(--rule-2);position:relative;padding:0;
  transition:transform .15s ease,box-shadow .15s ease}
.card:hover{transform:translateY(-2px);box-shadow:4px 4px 0 var(--rule)}
.card-top{display:flex;align-items:stretch;border-bottom:1px solid var(--rule)}
/* 左侧的领域色条：用色块代替图标 */
.band{width:7px;flex:none}
.card-h{padding:12px 14px;flex:1;min-width:0}
.card-h .name{font-family:var(--cond);font-weight:600;font-size:1.05rem;letter-spacing:-.005em;
  padding-right:52px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card-h .name em{font-style:normal;color:var(--ink-3);font-weight:500}
.card-b{padding:12px 14px 14px}
.desc{color:var(--ink-2);font-size:.9rem;margin:0 0 12px;
  display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.fields{border-top:1px dotted var(--rule-2);padding-top:10px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 12px;font-size:.8rem;color:var(--ink-3)}
.fields b{font-weight:500;color:var(--ink-2);font-variant-numeric:tabular-nums}
.kw{display:flex;flex-wrap:wrap;gap:5px;margin-top:10px}
.kw span{font-size:.74rem;border:1px solid var(--rule-2);padding:1px 7px;color:var(--ink-3);background:var(--paper-2)}
.star{color:var(--accent);font-weight:600}
/* 卡片右上角的「档案编号」 */
.code{position:absolute;top:10px;right:12px;font-family:var(--cond);font-size:.72rem;letter-spacing:.08em;color:var(--ink-3)}
@media(max-width:640px){.cards{grid-template-columns:minmax(0,1fr)}.filing{gap:18px}}
</style>
</head>
<body>
<div class="wrap">
<header class="top">
  <div class="top-row">
    <h1>Stars Atlas<small>Index Card Catalogue · 索引卡片目录</small></h1>
    <div class="filing">
      <div>卡片<b>{{ meta.count }}</b></div>
      <div>星标<b>{{ meta.starsCompact }}</b></div>
      <div>领域<b>{{ facets.cats | selectattr('count') | list | length }}</b></div>
      <div>更新<b style="font-size:1rem">{{ updated.split(' ')[0] }}</b></div>
    </div>
  </div>
</header>

<nav class="tabs">
  {% for c in facets.cats %}{% if c.count %}
  <a class="tab{% if loop.first %} on{% endif %}" href="#{{ c.id }}">{{ c.en }}<i>{{ c.count }}</i></a>
  {% endif %}{% endfor %}
</nav>

{% for c in facets.cats %}{% if c.count %}
{% set group = board | selectattr('domain','equalto',c.id) | list %}
{% if group %}
<section id="{{ c.id }}">
  <div class="section-head">
    <h2>{{ c.en }} · {{ c.zh }}</h2>
    <span>{{ c.blurbEn }}</span>
  </div>
  <div class="cards">
    {% for it in group[:6] %}
    <a class="card" href="{{ it.url }}" target="_blank" rel="noopener">
      <span class="band" style="background:{{ it.color }}"></span>
      <span class="code">{{ it.domain_code }}-{{ '%03d' % (loop.index + 1) }}</span>
      <div class="card-top">
        <div class="card-h">
          <div class="name"><em>{{ it.owner }}/</em>{{ it.repo }}</div>
        </div>
      </div>
      <div class="card-b">
        <p class="desc">{{ it.summary }}</p>
        <div class="fields">
          <span>Star</span><b class="star">★ {{ it.stars_str }}</b>
          <span>语言</span><b>{{ it.lang }}</b>
          <span>分类</span><b>{{ it.sub_zh }}</b>
          <span>最近提交</span><b>{{ it.pushed }}</b>
        </div>
        <div class="kw">
          {% for t in it.tags[:4] %}<span>{{ t }}</span>{% endfor %}
        </div>
      </div>
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}
{% endif %}{% endfor %}

<footer style="margin-top:56px;border-top:3px double var(--rule-2);padding-top:18px;font-size:.8rem;color:var(--ink-3);font-family:var(--cond);letter-spacing:.04em">
  数据来自 GitHub Stars · 分类由规则引擎生成 · 更新于 {{ updated }}
</footer>
</div>
</body>
</html>
